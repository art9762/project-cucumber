# Database
DB_URL=postgresql+asyncpg://findengine:findengine@localhost:5432/findengine

# GitHub API (optional but recommended to avoid low anonymous rate limits)
GITHUB_TOKEN=

# Reddit (optional; public JSON works without it but is rate-limited)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=find-engine/0.1 (by u/yourname)

# HTTP behavior
HTTP_TIMEOUT=30
HTTP_MAX_RETRIES=3

# Sources config (comma-separated)
GITHUB_TOPICS=ai,llm,machine-learning,agents
REDDIT_SUBREDDITS=MachineLearning,LocalLLaMA,artificial,singularity
ARXIV_CATEGORIES=cs.AI,cs.LG,cs.CL
HN_QUERY=AI OR LLM OR "machine learning"
HN_MIN_POINTS=10

# Scheduler cron (per source, standard 5-field cron). Empty = disabled.
CRON_ARXIV=0 */6 * * *
CRON_HACKERNEWS=0 */3 * * *
CRON_GITHUB=0 */6 * * *
CRON_REDDIT=0 */6 * * *
