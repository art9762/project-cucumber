# Конфиг прод-стека (deploy/docker-compose.prod.yml) + параметры deploy.sh.
# Скопировать в deploy/.env и заполнить. Реальный .env НИКОГДА не коммитим
# (закрыт корневым .gitignore: .env/.env.*).

# ---- VPS (используется только deploy.sh, не compose) ----
VPS_HOST=
VPS_USER=root
# Каталог на сервере. По умолчанию /opt/cucumber/deploy (нужен root/sudo на
# первое создание). Под non-root деплой-юзером без sudo укажи путь в его HOME,
# напр. /home/<user>/cucumber/deploy.
#REMOTE_DIR=/opt/cucumber/deploy
# Публичный порт proxy на хосте. По умолчанию 443 (HTTPS); если 443 занят
# другими сайтами на VPS — выбери свободный (напр. 41394). Внутри контейнера
# прокси всегда слушает TLS на 443.
#PUBLISH_PORT=443

# Session-cookie выдаётся с флагом Secure (только HTTPS). Прокси терминирует
# TLS, поэтому по умолчанию true. Ставь false ТОЛЬКО для отладки по plain-HTTP.
#COOKIE_SECURE=true

# ---- Версия образов из GHCR (тег docker.yml: 1.0.0 | latest | sha-...) ----
IMAGE_TAG=1.0.0

# ---- Postgres ----
# Генерация: openssl rand -base64 24
POSTGRES_PASSWORD=
ANALYSIS_PASSWORD=
ANALYSIS_RO_PASSWORD=

# ---- Analysis ----
# Trinity (Anthropic-совместимый шлюз) — токен обязателен.
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=https://gate.trinity.tg/aurora
# Генерация: openssl rand -base64 32
SESSION_SECRET=

# ---- Collector (опционально: без токенов работают анонимные лимиты) ----
GITHUB_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
